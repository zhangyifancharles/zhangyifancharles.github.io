---
interface Props { headings: { depth: number; slug: string; text: string }[]; }
const { headings } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---
{items.length > 0 && <aside class="article-toc" aria-label="Table of contents"><details open><summary>On this page</summary><nav aria-label="Article sections">{items.map((heading) => <a class:list={{ 'toc-sub': heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}</nav></details></aside>}
