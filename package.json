{
  "name": "personal-website",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/astro.mjs check && node scripts/astro.mjs build && node scripts/check-output.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "test": "node --test tests/*.test.mjs",
    "release:check": "node scripts/check-profile.mjs",
    "verify": "npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "katex": "0.19.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "linkedom": "0.18.14",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
